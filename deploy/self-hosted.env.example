# SPDX-License-Identifier: AGPL-3.0-or-later
# A studio's own NicGit server (docs/self-hosting.md). Copy to deploy/nicgit.env and fill in. Never commit it.
NICGIT_DEPLOYMENT=self-hosted
# The release to run. Server and workers always run the same one.
NICGIT_VERSION=0.1.0
# Where the images come from: <prefix>-server and <prefix>-worker. `nicgit` means images built here with
# scripts/build-images.sh.
NICGIT_IMAGE_PREFIX=nicgit

NICGIT_DB_PASSWORD=change-me
# Lets workers claim jobs; long and random (e.g. `openssl rand -hex 32`).
NICGIT_WORKER_TOKEN=change-me-too
# The address people use; https enables secure cookies. Google must allow <this>/api/auth/google/callback.
NICGIT_PUBLIC_URL=https://nicgit.studio.example
NICGIT_PORT=3000

# Sign-in: an OAuth client from Google Cloud Console (type "Web application"). Without it nobody can sign in.
NICGIT_GOOGLE_CLIENT_ID=
NICGIT_GOOGLE_CLIENT_SECRET=
# The Google account with this verified email is the site admin, and may always join.
NICGIT_SITE_ADMIN_EMAIL=
# Who else may join. Sign-up is closed on a self-hosted server: only verified addresses at these domains
# (comma list) get an account. Set NICGIT_SIGNUP=open to let any Google account join.
NICGIT_SIGNUP_DOMAINS=studio.example

# Engine workers: how many, and the memory each may use. Size them for your largest model (docs/ops.md).
NICGIT_WORKERS=2
NICGIT_WORKER_MEMORY=4g
# A job past this is stopped.
NICGIT_JOB_TIMEOUT_MINUTES=60

# Storage, in MB. Only your own people can join, so these guard against mistakes, not strangers:
# size them to your disk. One file, one project, one account; an organisation is an account of its own.
NICGIT_MAX_FILE_MB=1024
NICGIT_MAX_REPO_MB=10240
NICGIT_MAX_ACCOUNT_MB=51200
NICGIT_MAX_PROJECTS=1000
NICGIT_MAX_ORGS=10

# AI summaries need an AI router (docs/ai-router.md). Leave empty to run without AI.
NICGIT_AI_ROUTER_URL=
NICGIT_AI_ROUTER_KEY=
