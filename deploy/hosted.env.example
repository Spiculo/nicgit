# SPDX-License-Identifier: AGPL-3.0-or-later
# Our hosted service on one machine (docs/hosting.md). Copy to deploy/nicgit.env and fill in. Never commit it;
# the real values live with the hosted service's private infrastructure, not in this repository.
NICGIT_DEPLOYMENT=hosted
NICGIT_VERSION=0.1.0
NICGIT_IMAGE_PREFIX=nicgit

NICGIT_DB_PASSWORD=change-me
# Lets workers claim jobs; long and random (e.g. `openssl rand -hex 32`).
NICGIT_WORKER_TOKEN=change-me-too
NICGIT_PUBLIC_URL=https://nicgit.example.com
NICGIT_PORT=3000

# Sign-in. Sign-up is open on the hosted service: any verified Google account can join.
NICGIT_GOOGLE_CLIENT_ID=
NICGIT_GOOGLE_CLIENT_SECRET=
NICGIT_SITE_ADMIN_EMAIL=

NICGIT_WORKERS=2
NICGIT_WORKER_MEMORY=4g
NICGIT_JOB_TIMEOUT_MINUTES=60

# What one person can store, in MB, since anyone can sign up (decision N33): one file, one project, one
# account. An organisation is an account of its own, so the number of them matters too.
NICGIT_MAX_FILE_MB=512
NICGIT_MAX_REPO_MB=2048
NICGIT_MAX_ACCOUNT_MB=5120
NICGIT_MAX_PROJECTS=100
NICGIT_MAX_ORGS=3

# The cloud AI router (docs/ai-router.md).
NICGIT_AI_ROUTER_URL=
NICGIT_AI_ROUTER_KEY=
