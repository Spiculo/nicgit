# SPDX-License-Identifier: AGPL-3.0-or-later
# Copy to nicgit.env and fill in. Never commit the real file.
NICGIT_DB_PASSWORD=change-me
# Lets workers claim jobs; long and random (e.g. `openssl rand -hex 32`).
NICGIT_WORKER_TOKEN=change-me-too
# The address people use; https enables secure cookies. Google must allow <this>/api/auth/google/callback.
NICGIT_PUBLIC_URL=https://nicgit.example.com
NICGIT_PORT=3000
# Sign-in: an OAuth client from Google Cloud Console (type "Web application"). Without it nobody can sign in.
NICGIT_GOOGLE_CLIENT_ID=
NICGIT_GOOGLE_CLIENT_SECRET=
# The Google account with this verified email is the site admin.
NICGIT_SITE_ADMIN_EMAIL=
# Engine workers: how many, and the memory each may use.
NICGIT_WORKERS=2
NICGIT_WORKER_MEMORY=4g
NICGIT_MAX_UPLOAD_MB=2048
# The cloud AI router (docs/ai-router.md). Leave empty to run without AI.
NICGIT_AI_ROUTER_URL=
NICGIT_AI_ROUTER_KEY=
